{
  "name": "aura-enterprise",
  "version": "1.0.0",
  "description": "Mobile-first confidential payroll and tipping on Solana",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev:server": "node --import tsx/esm server.js",
    "dev:client": "npm run dev --prefix client",
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "build": "npm run build --prefix client"
  },
  "dependencies": {
    "@noble/curves": "^1.3.0",
    "@noble/hashes": "^1.3.3",
    "@solana/spl-token": "^0.3.9",
    "@solana/web3.js": "^1.87.6",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "tsx": "^4.7.0"
  },
  "devDependencies": {
    "@types/node": "^22.13.11",
    "concurrently": "^8.2.2",
    "typescript": "^5.3.3"
  }
}
